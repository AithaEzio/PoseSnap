// PoseSnap: read-only selected-figure metadata. No asset loading or scene edits.
(function () {
  var job = __POSESNAP_CONFIG__;
  function checkCancelled() {
    if (new DzFileInfo(job.cancel).exists()) { throw new Error("Rig connection cancelled"); }
  }
  function acknowledge(result) {
    result.version = 1; result.jobId = job.jobId;
    var file = new DzFile(job.ack);
    if (!file.open(DzFile.WriteOnly)) { throw new Error("Could not write PoseSnap acknowledgment"); }
    file.write(JSON.stringify(result)); file.close();
  }
  function vector(value) { return [Number(value.x), Number(value.y), Number(value.z)]; }
  function defaultAngles(node) { return [node.getOrientXControl().getDefaultValue(), node.getOrientYControl().getDefaultValue(), node.getOrientZControl().getDefaultValue()]; }
  function order(node) {
    var value = node.getRotationOrder();
    return "XYZ".charAt(Number(value.firstAxis)) + "XYZ".charAt(Number(value.secondAxis)) + "XYZ".charAt(Number(value.thirdAxis));
  }
  function inputUrl(id, axis) { return id + ":#" + id + "?rotation/" + axis; }
  function bodyRotation(id) {
    var name=id.toLowerCase();
    if(name.indexOf("pectoral")>=0) { return false; }
    if(name.indexOf("forearm")>=0) { return true; }
    for(var p=0;p<job.excludedParts.length;p++) {
      if(name.indexOf(job.excludedParts[p])>=0) { return false; }
    }
    return true;
  }
  try {
    checkCancelled();
    var figure = Scene.getPrimarySelection();
    if (figure && figure.inherits("DzBone")) { figure = figure.getSkeleton(); }
    if (!figure || !figure.inherits("DzSkeleton")) { throw new Error("Select a matching Genesis figure in DAZ Studio first"); }
    var g9 = figure.findNodeChild("l_thigh", true), g8 = figure.findNodeChild("lThighBend", true);
    if ((job.rigId === "g9" && !g9) || (job.rigId !== "g9" && !g8)) { throw new Error("Select " + job.label + " to connect this generation"); }
    var uri = String(figure.assetUri).toLowerCase() + " " + String(figure.assetSource).toLowerCase();
    if (job.rigId !== "g9") {
      var female = uri.indexOf("genesis8female") >= 0 || uri.indexOf("/female/") >= 0;
      var male = uri.indexOf("genesis8male") >= 0 || uri.indexOf("/male/") >= 0;
      if ((!female && !male) || (job.rigId === "g8f" && !female) || (job.rigId === "g8m" && !male)) { throw new Error("Select " + job.label + " to connect this generation"); }
    }
    var members = [figure], descendants = figure.getNodeChildren(true), axes = ["X","Y","Z"];
    for (var i=0;i<descendants.length;i++) {
      if (descendants[i].inherits("DzBone") && descendants[i].getSkeleton() === figure) { members.push(descendants[i]); }
    }
    var nodes = [], refs = [], map = {}, formulas = [];
    for (var i=0;i<members.length;i++) {
      var node=members[i], id=String(node.getName()), limits={};
      if (map[id]) { throw new Error("Duplicate bone name in selected rig: " + id); }
      for(var a=0;a<3;a++) {
        var prop=node["get"+axes[a]+"RotControl"]();
        limits[axes[a].toLowerCase()]={min:prop.getMin(),max:prop.getMax(),clamped:prop.isClamped(),locked:prop.isLocked()};
        // Use exactly the body-export scope. Facial and pectoral correctives
        // belong to the character and must not qualify or block body posing.
        if(node===figure || bodyRotation(id)) { refs.push({property:prop,id:id,axis:axes[a].toLowerCase()}); }
      }
      var parent=node.getNodeParent();
      var item={id:id,name:id,type:node===figure?"figure":"bone",parent:node===figure?null:String(parent.getName()),center:vector(node.getOrigin(true)),end:vector(node.getEndPoint(true)),orientation:defaultAngles(node),order:order(node),limits:limits};
      nodes.push(item);map[id]=item;
    }
    for(var i=0;i<refs.length;i++) {
      var target=refs[i], controllers=target.property.getControllerList();
      for(var c=0;c<controllers.length;c++) {
        var link=controllers[c];
        if(!link.inherits("DzERCLink")) { throw new Error("Unsupported rotation controller on "+target.id+"/"+target.axis); }
        if(!link.active) { continue; }
        var input=link.getProperty(), matched=null;
        for(var r=0;r<refs.length;r++) { if(refs[r].property===input) { matched=refs[r];break; } }
        if(!matched) {
          // Installed pose/morph controls at their neutral defaults are not base bone relationships.
          var neutral=input && typeof input.getDefaultValue==="function" ? Number(input.getDefaultValue()) : NaN;
          var addend=Number(link.addend);
          if((link.type===DzERCLink.ERCDeltaAdd || link.type===DzERCLink.ERCAdd || link.type===DzERCLink.ERCSubtract) && neutral===0 && addend===0) { continue; }
          if(link.type===DzERCLink.ERCMultiply && neutral===1 && addend===0) { continue; }
          if(link.type===DzERCLink.ERCDivideBy && neutral===1 && addend===0) { continue; }
          if(link.type===DzERCLink.ERCKeyed && isFinite(neutral) && Number(link.getKeyOpValue(neutral))===0) { continue; }
          throw new Error("A custom controller affects "+target.id+"/"+target.axis+" ("+(input ? input.getName() : "missing input")+"). This optional rig connection was not changed. You can still use the built-in Genesis rig.");
        }
        var operations=[{op:"push",url:inputUrl(matched.id,matched.axis)}], stage="sum", coefficient=1;
        if(link.type===DzERCLink.ERCDeltaAdd) { coefficient=Number(link.scalar); }
        else if(link.type===DzERCLink.ERCSubtract) { coefficient=-1; }
        else if(link.type===DzERCLink.ERCMultiply && Number(link.addend)===0) { stage="mult"; }
        else if(link.type!==DzERCLink.ERCAdd) { throw new Error("Unsupported rotation relationship on "+target.id+"/"+target.axis); }
        if(coefficient!==1) { operations.push({op:"push",val:coefficient},{op:"mult"}); }
        if(Number(link.addend)!==0) { operations.push({op:"push",val:Number(link.addend)},{op:"add"}); }
        formulas.push({output:inputUrl(target.id,target.axis),stage:stage,operations:operations});
        if(!map[target.id].driven) { map[target.id].driven=[]; }
        if(map[target.id].driven.indexOf(target.axis)<0) { map[target.id].driven.push(target.axis); }
      }
    }
    checkCancelled();
    acknowledge({success:true,profile:{version:4,id:job.rigId,label:job.label,sourceId:String(figure.getName()),nodes:nodes,formulas:formulas},figure:String(figure.getLabel())});
  } catch(error) { acknowledge({success:false,message:String(error)}); }
}());
